{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShabasherDbContext": "${DB_CONNECTION_STRING}"
  },
  "JwtOptions": {
    "SecretKey": "${JWT_SECRET}",
    "ExpiresHours": "${JWT_HOURS}"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "S3": {
    "Endpoint": "${ENDPOINT}",
    "Region": "${REGION}",
    "AccessKey": "${KEY_ID}",
    "SecretKey": "${KEY_SECRET}",
    "BucketName": "${S3_BUCKET}"
  }
}