{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShabasherDbContext": "${DB_CONNECTION_STRING}"
  },
  "JwtOptions": {
    "SecretKey": "${JWT_SECRET}",
    "ExpiresHours": "${JWT_HOURS}"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "S3": {
    "Endpoint": "https://s3.cloud.ru/shabasher-storage",
    "Region": "ru-central-1",
    "AccessKey": "${KEY_ID}",
    "SecretKey": "${KEY_SECRET}",
    "BucketName": "shabasher-storage"
  }
}